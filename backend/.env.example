# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# Google AI Studio key (https://aistudio.google.com/apikey) - stays on the server only
GEMMA_API_KEY=

# Your preferred model and the list the frontend is allowed to pick from
GEMMA_MODEL=gemma-4-31b-it
ALLOWED_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it

# Which model answers first. "fast" (default): the newest Gemini Flash answers first and GEMMA_MODEL is the
# backup, because Gemma on the free tier is often slow. Use "configured" to try GEMMA_MODEL first.
AI_MODEL_ORDER=fast

# Optional. Leave empty: the server asks Google which models your key can use and
# automatically falls back to the newest stable Gemini Flash when the main model fails.
FALLBACK_MODELS=

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

DATABASE_PATH=./gauvaani.db
